<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Angaben, die in der Exe landen und in ihren Dateieigenschaften auftauchen. Ohne sie
      steht dort nichts: Manche Virenscanner werten eine Datei ohne Versionsangabe als
      verdaechtig, und ein Fehlerbericht ohne Versionsnummer ist Raten.

      Version ist die eine Stelle, an der sie gepflegt wird — die uebrigen leiten sich ab.
      Sie muss beim Veroeffentlichen mit der Version im Paketmanifest uebereinstimmen.
    -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Company>RINGPAPERS</Company>
    <Product>DiskStats</Product>
    <Authors>RINGPAPERS</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 RINGPAPERS</Copyright>
    <Description>Sieh, wohin dein Speicherplatz geht.</Description>
  </PropertyGroup>
</Project>
